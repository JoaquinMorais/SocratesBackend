# ---------------------------------------------------------------------------
# PostgreSQL / Docker Compose
# ---------------------------------------------------------------------------
# Valores de ejemplo. Cambiar la contraseña y mantener DATABASE_URL sincronizada.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=socrates_db

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/socrates_db
SECRET_KEY=change-me-generate-a-long-random-key
ALGORITHM=HS256
ACCESS_MINUTES=15
REFRESH_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Códigos OTP por mail
OTP_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
EMAIL_DOMAIN=sistemas.frc.utn.edu.ar

# Mail: por defecto se imprime en los logs del backend.
EMAIL_BACKEND=console
EMAIL=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_DEV_REDIRECT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=10
SEND_WELCOME_EMAILS=true

# Imágenes: se guardan en MEDIA_DIR (local) y se sirven bajo MEDIA_BASE_URL.
MEDIA_DIR=media
MEDIA_BASE_URL=http://localhost:8000/media
IMAGE_MAX_BYTES=5000000
IMAGE_WEBP_QUALITY=85

# Asistencia
ATTENDANCE_CODE_MINUTES=10
ATTENDANCE_TRANSCRIPT_MAX_BYTES=2000000
ATTENDANCE_NAME_SIMILARITY=0.75
