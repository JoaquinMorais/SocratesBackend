# Imágenes: se guardan en MEDIA_DIR (local) y se sirven bajo MEDIA_BASE_URL.
# Sin cambios funcionales si no se definen: los valores por defecto son válidos.
MEDIA_DIR=media
MEDIA_BASE_URL=http://localhost:8000/media
IMAGE_MAX_BYTES=5000000
IMAGE_WEBP_QUALITY=85
ATTENDANCE_CODE_MINUTES=10
ATTENDANCE_TRANSCRIPT_MAX_BYTES=2000000
ATTENDANCE_NAME_SIMILARITY=0.75
